FROM node:18-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files
COPY frontend/package.json frontend/pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install

# Copy the rest of the application
COPY frontend/ ./

# Create data directory
RUN mkdir -p data

# Expose the port
EXPOSE 5174

# Command to run the app
CMD ["pnpm", "run", "dev", "--host", "0.0.0.0"]
